ARG CODEX_RUNTIME_IMAGE=crpi-pvisgh9yojd87fkj.cn-hangzhou.personal.cr.aliyuncs.com/altselfs/codex-app-server:latest
ARG HERMES_RUNTIME_IMAGE=crpi-pvisgh9yojd87fkj.cn-hangzhou.personal.cr.aliyuncs.com/altselfs/hermes-runtime:latest

FROM ${CODEX_RUNTIME_IMAGE} AS codex-runtime
FROM ${HERMES_RUNTIME_IMAGE} AS hermes-runtime

FROM node:22-bookworm-slim AS server-build

WORKDIR /app
COPY package.json tsconfig.json ./
RUN npm install

COPY src ./src
RUN npm run build

FROM node:22-bookworm-slim AS runtime

ARG TARGETARCH
ARG TIRITH_VERSION=0.3.3
ARG TIRITH_AMD64_SHA256=6cdbe35e8f9ccf42e70ad95b501c93cd218ac18201c3df958d54f6ba0d995ce2
ARG TIRITH_ARM64_SHA256=c784233083003a6a1533db9ebba30b1a7bb7cefaa239db6ca121598b384cca1a

WORKDIR /app

RUN apt-get update \
  && apt-get install -y --no-install-recommends ca-certificates curl poppler-utils python3 python3-venv python3-pip \
  && pip3 install --break-system-packages --no-cache-dir -i https://mirrors.aliyun.com/pypi/simple --trusted-host mirrors.aliyun.com pypdf pdfplumber python-docx openpyxl \
  && rm -rf /var/lib/apt/lists/*

RUN set -eux; \
  arch="${TARGETARCH:-$(dpkg --print-architecture)}"; \
  case "${arch}" in \
    amd64|x86_64) target="x86_64-unknown-linux-gnu"; expected_sha256="${TIRITH_AMD64_SHA256}" ;; \
    arm64|aarch64) target="aarch64-unknown-linux-gnu"; expected_sha256="${TIRITH_ARM64_SHA256}" ;; \
    *) echo "Unsupported Tirith architecture: ${arch}" >&2; exit 1 ;; \
  esac; \
  archive="tirith-${target}.tar.gz"; \
  curl --fail --show-error --location --retry 5 --retry-delay 2 \
    --output "/tmp/${archive}" \
    "https://github.com/sheeki03/tirith/releases/download/v${TIRITH_VERSION}/${archive}"; \
  echo "${expected_sha256}  /tmp/${archive}" | sha256sum -c -; \
  tar -xzf "/tmp/${archive}" -C /tmp tirith; \
  install -m 0755 /tmp/tirith /usr/local/bin/tirith; \
  test "$(tirith --version)" = "tirith ${TIRITH_VERSION}"; \
  rm -f "/tmp/${archive}" /tmp/tirith

COPY package.json ./
RUN npm install --omit=dev \
  && npm install -g @larksuite/cli@1.0.67

COPY --from=server-build /app/dist ./dist
COPY --from=codex-runtime /opt/altselfs/codex-bin /opt/altselfs/codex-bin
COPY --from=hermes-runtime /opt/altselfs/hermes-agent /opt/altselfs/hermes-agent
COPY --from=hermes-runtime /usr/local/bin/altselfs-hermes-run /usr/local/bin/altselfs-hermes-run
COPY scripts/patch-hermes-openrouter-runtime.mjs /tmp/patch-hermes-openrouter-runtime.mjs

RUN /opt/altselfs/hermes-agent/.venv/bin/pip install --no-cache-dir -i https://mirrors.aliyun.com/pypi/simple --trusted-host mirrors.aliyun.com 'mcp==1.28.1' 'anthropic==0.87.0' \
  && /opt/altselfs/hermes-agent/.venv/bin/python -c "import anthropic" \
  && ALTSELFS_HERMES_SOURCE_ROOT=/opt/altselfs/hermes-agent node /tmp/patch-hermes-openrouter-runtime.mjs \
  && rm -f /tmp/patch-hermes-openrouter-runtime.mjs

ENV NODE_ENV=production
ENV ALTSELFS_AGENT_ENV=production
ENV PORT=8787
ENV HERMES_SOURCE_RUNTIME_ENABLED=true
ENV HERMES_SOURCE_ROOT=/opt/altselfs/hermes-agent
ENV UV_BIN=/usr/local/bin/altselfs-hermes-run
ENV CODEX_BIN=/opt/altselfs/codex-bin/codex
ENV TIRITH_BIN=/usr/local/bin/tirith
ENV TIRITH_EXPECTED_VERSION=${TIRITH_VERSION}

EXPOSE 8787

HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
  CMD node -e "fetch('http://127.0.0.1:8787/healthz').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"

CMD ["node", "dist/index.js"]
